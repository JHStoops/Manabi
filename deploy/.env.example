# Copy to deploy/.env and fill in. Never commit the real .env.

# Release image version to run (a CI tag such as 0.1.0, or latest). Pin it to roll back.
MANABI_VERSION=latest

# Public URL users reach through Nginx Proxy Manager
PUBLIC_URL=https://manabi.example.com
# Host port the app listens on (point Nginx Proxy Manager here)
APP_PORT=3000

# Database. DATABASE_URL must use the same password as POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://manabi:change-me@db:5432/manabi

# Long random string, e.g. output of: openssl rand -hex 32
SESSION_SECRET=

# Which peers may set X-Forwarded-* headers. 1 (default) trusts one hop, Nginx Proxy Manager, so
# clients cannot spoof their address. Recommended: set Nginx Proxy Manager's IP (e.g. 192.168.1.10)
# so other machines on the LAN that reach APP_PORT cannot fake X-Forwarded-Proto either.
# Also accepts true, false, CIDR ranges, loopback, linklocal or uniquelocal (comma-separated).
TRUST_PROXY=1
# fatal, error, warn, info (default), debug, trace or silent
LOG_LEVEL=info

# Highest JLPT level the level-list import reads (N5, N4, N3, N2 or N1). Raise it, then run the
# import again to add that level.
LEVEL_CEILING=N3

# Hours until the next review at SRS stages 1 to 7 (stage 8 is retired). Empty uses the defaults:
# 4,24,72,168,336,720,2880 (4h, 1d, 3d, 1w, 2w, 1 month, 4 months).
SRS_INTERVAL_HOURS=

# Host folders (can be on a separate HDD mount). Backrest backs up MEDIA_DIR and DUMPS_DIR.
MEDIA_DIR=/mnt/hdd/manabi/media
DUMPS_DIR=/mnt/hdd/manabi/dumps
# Downloaded open datasets (JMdict, KANJIDIC2, KanjiVG, Tatoeba); re-downloadable, no backup needed
DATASETS_DIR=/mnt/hdd/manabi/datasets

# Text-to-speech threads: set to the LXC's vCPU count
OMP_NUM_THREADS=4

# Email is optional. Leave SMTP_* empty to run without email: invite links are then copied by
# hand and password resets use an admin-set temporary password. SMTP_PORT defaults to 587
# (STARTTLS); 465 uses TLS from the start. SMTP_FROM is required when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TZ=UTC
