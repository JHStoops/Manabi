{
  "name": "@manabi/api",
  "version": "0.0.0",
  "private": true,
  "description": "Manabi Fastify API and background worker.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "esbuild src/server.ts src/worker.ts src/migrate.ts src/cli.ts download=../../packages/importers/src/download.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --external:fastify --external:argon2 --external:@fastify/static --external:pg --external:node-pg-migrate --external:pg-boss --external:pino --external:pg-native --external:kuromoji --external:@manabi/importers/package.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "manabi": "tsx src/cli.ts",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "generate:client": "tsx src/generateClient.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.3",
    "@manabi/core": "*",
    "@manabi/importers": "*",
    "@manabi/lang-ja": "*",
    "argon2": "^0.45.2",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "smtp-server": "^3.21.7",
    "tsx": "^4.19.2"
  }
}
