#!/bin/sh
# FR-228: runs the full content lint before a push whose commits change content/, so the slow
# database checks (strokes, imported items) run here instead of in CI. Set DATABASE_URL to a
# database with the packs and datasets imported to include them; without it only the file checks
# run. Installed by `npm install` (the root `prepare` script sets core.hooksPath to .githooks).
changed=
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # all zeros: a branch is being deleted
  # The pushed commits are those no remote has yet.
  files=$(git log --format= --name-only "$local_sha" --not --remotes -- content/) || exit 1
  [ -n "$files" ] && changed=1
done
[ -n "$changed" ] || exit 0

# shortcut: lints the working tree, not the pushed commits, so uncommitted edits count and
# pushing an older commit lints newer files; lint a `git worktree` of $local_sha if that bites.
status=0
for course in content/*/course.yaml; do
  [ -f "$course" ] || continue
  npm run --silent manabi -- pack lint "$(dirname "$course")" || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: content lint failed; fix the problems above or push with --no-verify" >&2
exit $status
