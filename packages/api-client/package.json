{
  "name": "@manabi/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed fetch client for the Manabi API, generated from its OpenAPI document.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@manabi/core": "*",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript-helpers": "^0.1.0"
  }
}
