[
  {
    "id": 78634,
    "text": "来週までごきげんよう。"
  },
  {
    "id": 122159,
    "text": "日曜日に何をしますか。"
  },
  {
    "id": 126485,
    "text": "中国語かロシア語を話せますか。"
  },
  {
    "id": 144456,
    "text": "人は男か女のどちらかである。"
  },
  {
    "id": 150557,
    "text": "時間をかけてゆっくりやりなさい。"
  },
  {
    "id": 152107,
    "text": "私を中に入れてください。"
  },
  {
    "id": 152222,
    "text": "私もアルバイトしたいなあ。"
  },
  {
    "id": 153018,
    "text": "私は父さんにそのことを話した。"
  },
  {
    "id": 157103,
    "text": "私は高校一年生です。"
  },
  {
    "id": 159020,
    "text": "私はふつうバスで学校へいきます。"
  },
  {
    "id": 160067,
    "text": "私はその社長としりあいになった。"
  },
  {
    "id": 161139,
    "text": "きっぷをタダで手に入れたよ。"
  },
  {
    "id": 163432,
    "text": "私の車はどこにありますか。"
  },
  {
    "id": 164825,
    "text": "私にこのペンをください。"
  },
  {
    "id": 171874,
    "text": "今日の新聞を見せて下さい。"
  },
  {
    "id": 189637,
    "text": "雨になっちゃうんじゃないかなあ。"
  },
  {
    "id": 192408,
    "text": "ルーシーはもう電話しましたか。"
  },
  {
    "id": 195443,
    "text": "また後で。"
  },
  {
    "id": 196217,
    "text": "ホテルが見えてきた。"
  },
  {
    "id": 200909,
    "text": "どこの学生ですか。"
  },
  {
    "id": 201561,
    "text": "どうしてここへ来たのですか。"
  },
  {
    "id": 202750,
    "text": "ちょっと出しすぎだよ。"
  },
  {
    "id": 203810,
    "text": "たくさんのイヌが生きています。"
  },
  {
    "id": 205798,
    "text": "それだけで十分足りるだろう。"
  },
  {
    "id": 213596,
    "text": "そこへは行かないほうがよい。"
  },
  {
    "id": 216852,
    "text": "サイフがないのにふと気がついた。"
  },
  {
    "id": 218261,
    "text": "これは小さい本です。"
  },
  {
    "id": 219720,
    "text": "この本はあの本よりも小さい。"
  },
  {
    "id": 223320,
    "text": "このバッグを見せてください。"
  },
  {
    "id": 223439,
    "text": "このドレスは私にぴったりです。"
  },
  {
    "id": 224408,
    "text": "ここに十人ぐらいの少年がいる。"
  },
  {
    "id": 224632,
    "text": "ここではスリに気をつけて。"
  },
  {
    "id": 227937,
    "text": "エミはよい女の子だ。"
  },
  {
    "id": 228981,
    "text": "いつか電話してよ。"
  },
  {
    "id": 230908,
    "text": "あの車は私のです。"
  },
  {
    "id": 234313,
    "text": "あとでホテルに電話を下さい。"
  },
  {
    "id": 639906,
    "text": "トニーは何をしていますか。"
  },
  {
    "id": 872732,
    "text": "これはフランス語ですか？"
  },
  {
    "id": 1172446,
    "text": "そもそも話したの？"
  },
  {
    "id": 1191296,
    "text": "私は中学二年生です。"
  },
  {
    "id": 1231992,
    "text": "一週間後に会いましょう。"
  },
  {
    "id": 1411204,
    "text": "トムは今一人ではない。"
  },
  {
    "id": 1487307,
    "text": "ジョージと言います。"
  },
  {
    "id": 1799658,
    "text": "私にはできません。"
  },
  {
    "id": 1817745,
    "text": "何を見てるのかな。"
  },
  {
    "id": 2096199,
    "text": "くどくど言わないで。"
  },
  {
    "id": 2232977,
    "text": "フランス語はさっぱりできません。"
  },
  {
    "id": 2462018,
    "text": "分からないことは聞いてね。"
  },
  {
    "id": 2976084,
    "text": "お金は十分にあります。"
  },
  {
    "id": 3266681,
    "text": "口をつぐんでいるべきだった。"
  },
  {
    "id": 3468493,
    "text": "男が三人いた。"
  },
  {
    "id": 3488093,
    "text": "うまく行った！"
  },
  {
    "id": 3875295,
    "text": "パンは食べません。"
  },
  {
    "id": 3893070,
    "text": "スーパーに行ってきました。"
  },
  {
    "id": 4067632,
    "text": "トムはメアリーほど食べない。"
  },
  {
    "id": 4266848,
    "text": "トムはフランス語が話せます。"
  },
  {
    "id": 6704209,
    "text": "トムと行かせないでください。"
  },
  {
    "id": 7040357,
    "text": "じろじろ見るな。"
  },
  {
    "id": 8215946,
    "text": "私はオタクです。"
  },
  {
    "id": 8569437,
    "text": "シングルバーに行ったことある？"
  },
  {
    "id": 8688719,
    "text": "耳が聞こえないんですか？"
  },
  {
    "id": 8737195,
    "text": "あのパン、食べるつもり？"
  },
  {
    "id": 8819403,
    "text": "あれはトムの車？"
  },
  {
    "id": 8874648,
    "text": "それは見てないな。"
  },
  {
    "id": 8882010,
    "text": "私の父を見てませんか？"
  },
  {
    "id": 8963927,
    "text": "何でトムは外にいるの？"
  },
  {
    "id": 8969739,
    "text": "トムってよく食べるわね。"
  },
  {
    "id": 9162470,
    "text": "もう食べたくないよ。"
  },
  {
    "id": 9431923,
    "text": "あなたにはトムは年上すぎるのよ。"
  },
  {
    "id": 9518586,
    "text": "あなたがそれを書いたの？"
  },
  {
    "id": 9634577,
    "text": "それを飲むのはおっかないな。"
  },
  {
    "id": 9679071,
    "text": "月曜日はお休みです。"
  },
  {
    "id": 9696208,
    "text": "フランス語の本を読みなさい。"
  },
  {
    "id": 9807681,
    "text": "中国語はなんとなくわかります。"
  },
  {
    "id": 9843845,
    "text": "ほら、言わんこっちゃない。"
  },
  {
    "id": 9930567,
    "text": "一口かじってもいい？"
  },
  {
    "id": 10049587,
    "text": "少しだけアイヌ語が話せます。"
  },
  {
    "id": 10183288,
    "text": "足くじいたのか？"
  },
  {
    "id": 10306279,
    "text": "八月にレッスンはないよ。"
  },
  {
    "id": 10489091,
    "text": "いらないって言ったでしょ。"
  },
  {
    "id": 10489421,
    "text": "トムに聞いてみよっと。"
  },
  {
    "id": 10578509,
    "text": "フランス語でラブレター書ける？"
  },
  {
    "id": 10579882,
    "text": "名前にピンときた？"
  },
  {
    "id": 10913935,
    "text": "とばっちりが来なければいいけど。"
  },
  {
    "id": 10918338,
    "text": "来年私は大学を出ます。"
  },
  {
    "id": 10952515,
    "text": "うわあ！さっきのを見ましたか？"
  },
  {
    "id": 11041794,
    "text": "目をつぶって。"
  },
  {
    "id": 11241511,
    "text": "ここからは見えないよ。"
  },
  {
    "id": 11358817,
    "text": "チョコレートを食べた。"
  },
  {
    "id": 11510681,
    "text": "見たいのかしら？"
  },
  {
    "id": 11624333,
    "text": "今はトムに話しかけるなよ。"
  },
  {
    "id": 12151362,
    "text": "トムがテレビを見たがってるの。"
  },
  {
    "id": 12155985,
    "text": "今時の子はそんなことしないよ。"
  },
  {
    "id": 12438555,
    "text": "分をわきまえたまえ。"
  },
  {
    "id": 12492814,
    "text": "行きたいんなら、行けば。"
  },
  {
    "id": 12721560,
    "text": "この本を読んでほしい。"
  },
  {
    "id": 12954881,
    "text": "今日は金曜日だよ。"
  },
  {
    "id": 13195166,
    "text": "トムは新聞を読んでいる。"
  },
  {
    "id": 13252251,
    "text": "なんで一人でここにいるの？"
  },
  {
    "id": 13715753,
    "text": "人は人です。"
  }
]
