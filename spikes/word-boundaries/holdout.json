[
  {
    "id": 77152,
    "text": "話をして時間をつぶした。"
  },
  {
    "id": 137768,
    "text": "大あくびをして。"
  },
  {
    "id": 156905,
    "text": "私は今本を読んでいます。"
  },
  {
    "id": 164481,
    "text": "私にもミルクをちょうだい。"
  },
  {
    "id": 172936,
    "text": "今、ここがパリならばなあ。"
  },
  {
    "id": 182711,
    "text": "休みたいですか。"
  },
  {
    "id": 183263,
    "text": "気に入ってる？"
  },
  {
    "id": 194148,
    "text": "もう少しいてはいかがですか。"
  },
  {
    "id": 196852,
    "text": "ページの下を読んでごらん。"
  },
  {
    "id": 213907,
    "text": "そういう話もあったな。"
  },
  {
    "id": 219549,
    "text": "この本は日本では手に入らない。"
  },
  {
    "id": 224383,
    "text": "ここに来て、どれくらいになるの？"
  },
  {
    "id": 227736,
    "text": "おじが私に会いに来た。"
  },
  {
    "id": 228664,
    "text": "いつ行こうか。"
  },
  {
    "id": 229757,
    "text": "アレックスに聞いてみなさい。"
  },
  {
    "id": 233342,
    "text": "あなたの言うことは分かります。"
  },
  {
    "id": 405340,
    "text": "大人になったら何になる？"
  },
  {
    "id": 1614432,
    "text": "コーヒーふたつ下さい。"
  },
  {
    "id": 2719192,
    "text": "一人で行ってればよかったのに。"
  },
  {
    "id": 3423944,
    "text": "すみません、出口はどこですか？"
  },
  {
    "id": 3755890,
    "text": "私はピカソのようになりたい。"
  },
  {
    "id": 4264097,
    "text": "フランス語ができますか。"
  },
  {
    "id": 4865304,
    "text": "私は時間がある。"
  },
  {
    "id": 7809264,
    "text": "時間ある？"
  },
  {
    "id": 8728170,
    "text": "私のまねしてるの？"
  },
  {
    "id": 8843977,
    "text": "あれで十分かな？"
  },
  {
    "id": 8868595,
    "text": "何？何を話してるの？"
  },
  {
    "id": 10007271,
    "text": "それって、もみの木とちゃうよ。"
  },
  {
    "id": 10117721,
    "text": "ランチ、食べに行ってくるね。"
  },
  {
    "id": 10979928,
    "text": "それは人生のためになります！"
  },
  {
    "id": 11023078,
    "text": "かわい子ぶりやがって。"
  },
  {
    "id": 11199169,
    "text": "しっかり食べなさい。"
  },
  {
    "id": 11578418,
    "text": "飲みに行こうか？"
  },
  {
    "id": 11650261,
    "text": "これのこと言ってるの？"
  },
  {
    "id": 11741531,
    "text": "これって、なんでこんなに安いの？"
  },
  {
    "id": 11795624,
    "text": "マイクのスイッチ入れて。"
  },
  {
    "id": 11851954,
    "text": "ペンで書いてください。"
  },
  {
    "id": 12307452,
    "text": "お前んち、いつもきれいだよな。"
  },
  {
    "id": 12443683,
    "text": "トムはフランス語は話す。"
  },
  {
    "id": 12575581,
    "text": "そこにはもう行かないでください。"
  }
]
